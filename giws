def build_parser():
    parser = argparse.ArgumentParser(
        prog="giws",
        description="Generate C++ class wrappers to call Java methods/objects.",
    )
    parser.add_argument(
        "-f",
        "--description-file",
        metavar="FILE",
        help="description of the methods of the Java object",
    )
    parser.add_argument(
        "-o",
        "--output-dir",
        metavar="DIR",
        help="the directory where to export files",
    )
    parser.add_argument(
        "-p",
        "--per-package",
        action="store_true",
        help="generate CXX/HXX files per package instead of per object",
    )
    parser.add_argument(
        "-e",
        "--throws-exception-on-error",
        action="store_true",
        help="throw a C++ exception instead of an exit(EXIT_FAILURE)",
    )
    parser.add_argument(
        "-g",
        "--generate-exception-class",
        action="store_true",
        help="generate the exception class (disabled by default)",
    )
    parser.add_argument(
        "-r",
        "--disable-return-size-array",
        action="store_true",
        help="disable the return of the size of the array/arrays through int*",
    )
    parser.add_argument(
        "-s",
        "--enable-return-size-array",
        action="store_true",
        help="enable the return of the size of the array/arrays through int* (default)",
    )
    parser.add_argument(
        "--header-extension-file",
        metavar="EXT",
        default=None,
        help="extension of the generated header file [default: .hxx]",
    )
    parser.add_argument(
        "-b",
        "--body-extension-file",
        metavar="EXT",
        default=None,
        help="extension of the generated body file [default: .cpp]",
    )
    parser.add_argument(
        "-v",
        "--version",
        action="version",
        version=VERSION_TEXT,
        help="display the version information",
    )
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    config = configGiws()
    config.setFullCommandLine(sys.argv[1:] if argv is None else argv)

    if not args.description_file and not args.generate_exception_class:
        parser.error("you have to specify a description file")

    if args.description_file:
        if not os.path.isfile(args.description_file):
            parser.error(f"cannot find file {args.description_file}")
        config.setDescriptionFile(args.description_file)

    if args.output_dir:
        if not os.path.isdir(args.output_dir):
            parser.error(f"cannot find output dir {args.output_dir}")
        config.setOutput(args.output_dir)

    if args.per_package:
        config.setSplitPerObject(False)

    if args.throws_exception_on_error:
        config.setThrowsException(True)

    if args.generate_exception_class:
        config.enableGenerateExceptionClass()

    if args.disable_return_size_array:
        config.setDisableReturnSize()

    if args.enable_return_size_array:
        config.setEnableReturnSize()

    if args.header_extension_file:
        config.setCPPHeaderExtension(args.header_extension_file)

    if args.body_extension_file:
        config.setCPPBodyExtension(args.body_extension_file)

    if config.getDescriptionFile():
        templateObj = parseXMLEngine(config.getDescriptionFile())

        CXX = CXXFile(templateObj.getJpackage())
        CXX.generateCXXHeader(config)
        CXX.generateCXXBody(config)

    if config.generateExceptionClass():
        CXXExcep = CXXException()
        CXXExcep.generateCXXHeader(config)
        CXXExcep.generateCXXBody(config)


if __name__ == "__main__":
    main()
